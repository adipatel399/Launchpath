# Free-tier route. Get keys from https://aistudio.google.com/apikey and https://app.tavily.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
# Optional alternative to Gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional gate for externally exposed deployments; send x-launchpath-token header.
LAUNCHPATH_API_TOKEN=
# Optional: real managed OAuth test connections through your Composio test project.
# Add the key here only in .env.local, never in chat or a public guide.
COMPOSIO_API_KEY=

# Optional: deployed HTTPS origin when running behind a reverse proxy.
APP_URL=

# Optional: Postgres storage for hosted guides and private setup attempts.
DATABASE_URL=
